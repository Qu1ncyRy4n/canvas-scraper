{
  "manifest_version": 3,
  "name": "Canvas Course Saver",
  "version": "0.4.0",
  "description": "Save Canvas courses (files, modules, pages, assignments) to Downloads/Canvas as linked Markdown. Pick courses from the toolbar icon.",
  "key": "",
  "action": {
    "default_title": "Canvas Course Saver",
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "canvas-course-saver@local",
      "strict_min_version": "121.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.instructure.com/*"
      ],
      "js": [
        "turndown.js",
        "content.js"
      ]
    }
  ]
}
